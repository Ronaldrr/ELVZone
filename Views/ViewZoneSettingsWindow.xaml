<Window x:Class="ELVZone.Views.ViewZoneSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки зон обзора"
        Width="920"
        Height="680"
        MinWidth="820"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinWidth" Value="240"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Width" Value="90"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock Text="{Binding StatusMessage}" MinWidth="260" Foreground="#406070"/>
            <Button Content="Импорт" Click="ImportButton_Click"/>
            <Button Content="Экспорт" Click="ExportButton_Click"/>
            <Button Content="Сброс" Click="ResetButton_Click"/>
            <Button Content="Сохранить" Click="SaveButton_Click" FontWeight="SemiBold"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Параметры камеры" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Горизонтальный угол"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.HorizontalAngleParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="0" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.HorizontalAngleParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="По умолчанию, град."/>
                    <TextBox Grid.Row="0" Grid.Column="4" Text="{Binding Settings.DefaultHorizontalAngleDegrees, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Вертикальный угол"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.VerticalAngleParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.VerticalAngleParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" Text="По умолчанию, град."/>
                    <TextBox Grid.Row="1" Grid.Column="4" Text="{Binding Settings.DefaultVerticalAngleDegrees, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Высота установки"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.MountingHeightParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.MountingHeightParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding Settings.DefaultMountingHeightMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Длина зоны 1"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.Zone1LengthParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="3" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.Zone1LengthParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="3" Grid.Column="4" Text="{Binding Settings.DefaultZone1LengthMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Длина зоны 2"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.Zone2LengthParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="4" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.Zone2LengthParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="4" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="4" Grid.Column="4" Text="{Binding Settings.DefaultZone2LengthMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Длина зоны 3"/>
                    <CheckBox Grid.Row="5" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.Zone3LengthParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="5" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.Zone3LengthParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="5" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="5" Grid.Column="4" Text="{Binding Settings.DefaultZone3LengthMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Длина зоны 4"/>
                    <CheckBox Grid.Row="6" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.Zone4LengthParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="6" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.Zone4LengthParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="6" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="6" Grid.Column="4" Text="{Binding Settings.DefaultZone4LengthMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Общая длина"/>
                    <CheckBox Grid.Row="7" Grid.Column="1" Content="Вкл." IsChecked="{Binding Settings.TotalLengthParameter.IsEnabled}"/>
                    <ComboBox Grid.Row="7" Grid.Column="2" ItemsSource="{Binding ParameterNames}" Text="{Binding Settings.TotalLengthParameter.ParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Row="7" Grid.Column="3" Text="По умолчанию, м"/>
                    <TextBox Grid.Row="7" Grid.Column="4" Text="{Binding Settings.DefaultTotalLengthMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="8" Grid.Column="0" Text="Нижняя высота анализа h1"/>
                    <TextBlock Grid.Row="8" Grid.Column="1" Text=""/>
                    <TextBlock Grid.Row="8" Grid.Column="2" Text="От уровня активного плана"/>
                    <TextBlock Grid.Row="8" Grid.Column="3" Text="h1, м"/>
                    <TextBox Grid.Row="8" Grid.Column="4" Text="{Binding Settings.AnalysisBottomHeightMeters, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="9" Grid.Column="0" Text="Верхняя высота анализа h2"/>
                    <TextBlock Grid.Row="9" Grid.Column="1" Text=""/>
                    <TextBlock Grid.Row="9" Grid.Column="2" Text="От уровня активного плана"/>
                    <TextBlock Grid.Row="9" Grid.Column="3" Text="h2, м"/>
                    <TextBox Grid.Row="9" Grid.Column="4" Text="{Binding Settings.AnalysisTopHeightMeters, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>

                <TextBlock Text="Стили зон" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Зона" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Заливка" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Стиль штриховки" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="Линии" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="Стиль линий" FontWeight="SemiBold"/>

                    <ItemsControl Grid.Row="1" Grid.ColumnSpan="5" ItemsSource="{Binding ZoneRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title}"/>
                                    <CheckBox Grid.Column="1" Content="Вкл." IsChecked="{Binding FillEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding DataContext.FilledRegionTypeNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="False"
                                              SelectedItem="{Binding FilledRegionTypeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <CheckBox Grid.Column="3" Content="Вкл." IsChecked="{Binding LineEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding DataContext.LineStyleNames, RelativeSource={RelativeSource AncestorType=Window}}"
                                              IsEditable="False"
                                              SelectedItem="{Binding LineStyleName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
